  <section id="padroeiro-devocoes" aria-labelledby="titulo-padroeiro-devocoes" class="mb-10 pt-4 border-b border-gray-100 pb-6">
    <h3 id="titulo-padroeiro-devocoes" class="dia-liturgia text-2xl font-bold text-gray-900 mb-3 sm">
